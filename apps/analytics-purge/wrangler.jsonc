{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orange-replay-analytics-purge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "containers": [
    {
      "name": "orange-replay-analytics-purge",
      "class_name": "AnalyticsPurgeContainer",
      "image": "../../infra/analytics/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2",
      "rollout_active_grace_period": 1800,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANALYTICS_PURGE_CONTAINER",
        "class_name": "AnalyticsPurgeContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnalyticsPurgeContainer"],
    },
  ],
  "secrets": {
    "required": [
      "ORANGE_REPLAY_PURGE_API_URL",
      "ANALYTICS_PURGE_RUNNER_TOKEN",
      "R2_CATALOG_URI",
      "R2_SQL_WAREHOUSE",
      "ORANGE_REPLAY_CATALOG_TOKEN",
    ],
  },
}
