/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/or-recorder.*.js
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/or-recorder-manifest.json
  Cache-Control: no-store

/brand/*
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
